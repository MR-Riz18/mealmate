# MealMate server — copy to .env and fill in your own values.
# Never commit a real .env with secrets.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/mealmate
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE=8h
CLIENT_URL=http://localhost:5173
# Optional Spoonacular key; leave empty to use seeded recipes only.
RECIPE_API_KEY=
